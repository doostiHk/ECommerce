{
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/Core",
    "ClientId": "web-frontend",
    "AdminUsername": "admin",
    "AdminPassword": "admin_strong"
  },
  "ReverseProxy": {
    "Routes": {
      "product-route": {
        "ClusterId": "product-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/products/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "product-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:7002/" }
        }
      },
      "order-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:7003/" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:7004/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
