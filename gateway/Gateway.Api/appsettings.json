{
  "ReverseProxy": {
    "Routes": {
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/products/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "product-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://product-service:7002/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://product-service:7003/"
          }
        }
      },
      "notification-cluster" :{
        "Destinations": {
          "d1": {
            "Address": "http://product-service:7004/"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
