{
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/Core",
    "MetadataAddress": "http://localhost:8080/realms/Core/.well-known/openid-configuration",
    "ClientId": "web-frontend",
    "AdminUsername": "admin",
    "AdminPassword": "admin_strong",
    "RequireHttpsMetadata": false,
    "ValidIssuers": [
      "http://localhost:8080/realms/Core",
      "http://keycloak:8080/realms/Core"
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:7000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "product-read-route": {
        "ClusterId": "product-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/products/{**catch-all}",
          "Methods": [ "GET", "HEAD", "OPTIONS" ]
        }
      },
      "product-write-route": {
        "ClusterId": "product-cluster",
        "AuthorizationPolicy": "Admin",
        "Match": {
          "Path": "/products/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "product-swagger-route": {
        "ClusterId": "product-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/product-swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "product-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:7002/" }
        }
      },
      "order-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:7003/" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:7004/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
